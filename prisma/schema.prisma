// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum TransactionType {
  PAYMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum AccountType {
  USER
  PLATFORM
  PROVIDER
}

enum ProviderType {
  FLIGHT
  PAYMENT
  STAYS
  CAR
}

model User {
  userId   String @id @default(uuid()) @db.Uuid
  password String @default("Password123!")

  email     String  @unique
  firstName String?
  lastName  String?
  phone     String?

  passportNumber     String?
  passportCountry    String?
  passportExpiryDate DateTime?

  customFields Json?

  passengers   Passenger[]
  bookings     Booking[]
  transactions Transaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([phone])
  @@map("users")
}

model Passenger {
  passengerId String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  type PassengerType

  firstName String
  lastName  String

  dateOfBirth DateTime?
  gender      String?
  nationality String?

  passportNumber    String?
  passportCountry   String?
  passportExpiryDate DateTime?

  customFields Json?

  user User @relation(fields: [userId], references: [userId])

  bookingPassengers BookingPassenger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([passportNumber])
  @@map("passengers")
}

model Booking {
  bookingId String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  provider            String
  providerBookingId   String?

  status BookingStatus @default(PENDING)

  totalAmount Decimal @db.Decimal(20, 2)
  currency    String  @db.Char(3)

  customFields Json?

  user        User      @relation(fields: [userId], references: [userId])
  providerRef Provider? @relation(fields: [provider], references: [code])

  bookingPassengers BookingPassenger[]

  transactions Transaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([provider, providerBookingId])
  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model BookingPassenger {
  bookingPassengerId String @id @default(uuid()) @db.Uuid

  bookingId   String @db.Uuid
  passengerId String @db.Uuid

  customFields Json?

  booking   Booking   @relation(fields: [bookingId], references: [bookingId])
  passenger Passenger @relation(fields: [passengerId], references: [passengerId])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([bookingId, passengerId])
  @@index([passengerId])
  @@map("booking_passengers")
}

model Transaction {
  transactionId String @id @default(uuid()) @db.Uuid

  userId    String @db.Uuid
  bookingId String @db.Uuid

  type   TransactionType
  status TransactionStatus @default(PENDING)

  amount   Decimal @db.Decimal(20, 2)
  currency String  @db.Char(3)

  provider              String?
  providerTransactionId String?

  customFields Json?

  user        User      @relation(fields: [userId], references: [userId])
  booking     Booking   @relation(fields: [bookingId], references: [bookingId])
  providerRef Provider? @relation(fields: [provider], references: [code])

  entries TransactionEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([provider, providerTransactionId])
  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@map("transactions")
}

model TransactionEntry {
  transactionEntryId String @id @default(uuid()) @db.Uuid

  transactionId String @db.Uuid

  accountType AccountType
  accountId   String      @db.Uuid

  direction EntryDirection

  amount   Decimal @db.Decimal(20, 2)
  currency String  @db.Char(3)

  customFields Json?

  transaction Transaction @relation(fields: [transactionId], references: [transactionId])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([transactionId])
  @@index([accountType, accountId])
  @@map("transaction_entries")
}

model Currency {
  currencyId String @id @default(uuid()) @db.Uuid

  code          String  @unique @db.Char(3)
  name          String
  symbol        String?
  decimalDigits Int     @default(2)

  customFields Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("currencies")
}

model Provider {
  providerId String @id @default(uuid()) @db.Uuid

  code String       @unique
  name String
  type ProviderType

  isActive    Boolean @default(true)
  description String?

  customFields Json?

  bookings     Booking[]
  transactions Transaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("providers")
}
