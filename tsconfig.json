{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@servers/*": ["src/servers/*"],
      "@handlers/*": ["src/handlers/*"],
      "@shared/*": ["src/shared/*"],
      "@types/*": ["src/types/*"],
      "@generated/*": ["src/generated/*"]
    }
  },
  "include": ["src"]
}
